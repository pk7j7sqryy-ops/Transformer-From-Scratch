<mxfile host="app.diagrams.net" agent="Trae" version="26.0.3">
  <diagram name="Transformer翻译项目结构" id="project-structure">
    <mxGraphModel dx="1400" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========== 根节点 ========== -->
        <mxCell id="root" value="&lt;b style='font-size:16px'&gt;Transformer 翻译项目&lt;/b&gt;&lt;br&gt;&lt;span style='color:#CCCCCC'&gt;中 → 英翻译&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4B3FE3;strokeColor=#4B3FE3;fontColor=#FFFFFF;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ========== main.py 入口 ========== -->
        <mxCell id="main" value="&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;&lt;span style='color:#888;font-size:10px'&gt;项目统一入口&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0;border-top:1px solid #ddd;margin:4px 0'&gt;&lt;div style='font-family:Courier New;font-size:10px;color:#333'&gt;python main.py preprocess &amp;nbsp;# 预处理&lt;br&gt;python main.py train &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;# 训练&lt;br&gt;python main.py evaluate &amp;nbsp;# 评估&lt;br&gt;python main.py predict &amp;nbsp;&amp;nbsp;# 翻译&lt;br&gt;python main.py serve &amp;nbsp;&amp;nbsp;&amp;nbsp;# 启动服务&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e-root-main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF9800;strokeWidth=1.5;dashed=1;endArrow=open;" edge="1" parent="1" source="root" target="main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

