        <mxCell id="e-root-runner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4B3FE3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="root" target="g-runner">
