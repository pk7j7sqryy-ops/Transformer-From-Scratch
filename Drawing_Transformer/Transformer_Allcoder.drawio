        <mxCell id="WSiZDZiHRsR0KwA0mbfX-66" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;因果注意力矩阵代码中的矩阵变化&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;input：&amp;nbsp; &amp;nbsp;（B，S，D）=（B，S，H*dk）&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;wq、wk、wv：（D，D）&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;Q、K、V：&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; font-size: 22px;&quot;&gt;（B，S，D）-变换-》&lt;/b&gt;&lt;b style=&quot;font-size: 22px; background-color: transparent;&quot;&gt;（B，S，H，dk）-》&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 22px;&quot;&gt;（B，H，S，dk）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;mask：（S，S）-广播-》（B，H，S，S）&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;score：（Q*K.T&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; font-size: 22px;&quot;&gt;/dk**0.5&lt;/b&gt;&lt;b style=&quot;font-size: 22px; background-color: transparent;&quot;&gt;&amp;nbsp;+MASK:(B,H,S,S)）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;；&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;只有当 batch 内序列不等长、使用 pad 补齐时，才需要额外的 padding mask&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;softmax&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;（Q*K.T&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; font-size: 22px;&quot;&gt;/dk**0.5&lt;/b&gt;&lt;b style=&quot;background-color: transparent; font-size: 22px;&quot;&gt; +MASK）&lt;/b&gt;&lt;b style=&quot;font-size: 22px; background-color: transparent;&quot;&gt;*V:(B,H,S,dk)--&amp;gt;(B,S,H,dk)--&amp;gt;(B,S,D)&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="430" width="755" x="-1275" y="23.88" as="geometry" />
        </mxCell>
